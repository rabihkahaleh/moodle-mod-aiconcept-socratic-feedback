<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/aiconcept/db" VERSION="2025091202" COMMENT="AI Concept plugin">
  <TABLES>

    <!-- Activity instance table -->
    <TABLE NAME="aiconcept" COMMENT="Instance table for the module">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_ix" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>

    <!-- One row per student interaction session -->
    <TABLE NAME="aiconcept_submissions" COMMENT="Top-level submission attempts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="assignmentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="inprogress"/>
        <FIELD NAME="finalcode" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid_ix" UNIQUE="false" FIELDS="cmid"/>
        <INDEX NAME="user_ix" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="course_ix" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>

    <!-- Every student/assistant message -->
    <TABLE NAME="aiconcept_turns" COMMENT="Per-turn dialogue logs and GPT replies">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submissionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="role" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="student"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="model" TYPE="char" LENGTH="50" NOTNULL="false"/>
        <FIELD NAME="usage_json" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="ok"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission_fk" TYPE="foreign" FIELDS="submissionid"
             REFTABLE="aiconcept_submissions" REFFIELDS="id" ONDELETE="cascade"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_ix" UNIQUE="false" FIELDS="submissionid"/>
        <INDEX NAME="role_ix" UNIQUE="false" FIELDS="role"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
